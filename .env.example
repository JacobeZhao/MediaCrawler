# Server
HOST=0.0.0.0
PORT=8088
HEADLESS=true
RELOAD=false

# Set false only when intentionally connecting to an existing browser session.
CDP_CONNECT_EXISTING=false
XHS_INTERNATIONAL=false

# Xiaohongshu login cookie, optional.
XHS_COOKIES=

# Runtime storage is SQLite.
SAVE_DATA_OPTION=sqlite
# SQLITE_DB_PATH=E:\project\MediaCrawler\database\sqlite_tables.db
# SERVICE_DB_PATH=E:\project\MediaCrawler\data\service.db

# Crawl pacing.
CRAWLER_MIN_SLEEP_SEC=1
CRAWLER_MAX_SLEEP_SEC=2
CRAWLER_MAX_NOTES_COUNT=15
CRAWLER_MAX_COMMENTS_COUNT_SINGLE_NOTE=10
