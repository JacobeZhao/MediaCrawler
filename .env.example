# Server
HOST=0.0.0.0
PORT=8088
HEADLESS=true
RELOAD=false

# Set false only when intentionally connecting to an existing browser session.
CDP_CONNECT_EXISTING=false
XHS_INTERNATIONAL=false

# Xiaohongshu login cookie, optional.
XHS_COOKIES=

# Runtime storage is SQLite.
SAVE_DATA_OPTION=sqlite
# SQLITE_DB_PATH=E:\project\MediaCrawler\database\sqlite_tables.db
# SERVICE_DB_PATH=E:\project\MediaCrawler\data\service.db

# Crawl pacing.
CRAWLER_MIN_SLEEP_SEC=3
CRAWLER_MAX_SLEEP_SEC=7
CRAWLER_GLOBAL_MIN_INTERVAL_SEC=2
CRAWLER_ACCOUNT_MIN_INTERVAL_SEC=8
CRAWLER_SEARCH_MIN_INTERVAL_SEC=10
CRAWLER_DETAIL_MIN_INTERVAL_SEC=8
CRAWLER_COMMENT_MIN_INTERVAL_SEC=12
CRAWLER_CREATOR_MIN_INTERVAL_SEC=12
CRAWLER_MAX_NOTES_COUNT=15
CRAWLER_MAX_COMMENTS_COUNT_SINGLE_NOTE=10

# Account-protection controls.
ACCOUNT_COOLDOWN_BASE_SEC=600
ACCOUNT_COOLDOWN_MAX_SEC=43200
ACCOUNT_HEALTH_CHECK_INTERVAL_SEC=900
TASK_PAUSE_ON_ACCOUNT_ERROR=true
CIRCUIT_WINDOW_SEC=600
CIRCUIT_PAUSE_SEC=3600
CIRCUIT_ERROR_THRESHOLD=3
TASK_MAX_ACCOUNT_SWITCHES=1
TASK_MAX_RUNTIME_SEC=7200
MAX_QUEUE_SIZE=200
MAX_BATCH_TASKS=50
